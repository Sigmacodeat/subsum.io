{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/(.*)",
      "has": [
        { "type": "header", "key": "origin", "value": "https://subsumio.com" }
      ],
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://subsumio.com" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,PATCH,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, Cookie, x-affine-version, x-operation-name, x-affine-csrf-token, x-request-id" }
      ]
    },
    {
      "source": "/api/(.*)",
      "has": [
        { "type": "header", "key": "origin", "value": "https://www.subsumio.com" }
      ],
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://www.subsumio.com" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,PATCH,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, Cookie, x-affine-version, x-operation-name, x-affine-csrf-token, x-request-id" }
      ]
    },
    {
      "source": "/api/(.*)",
      "has": [
        { "type": "header", "key": "origin", "value": "https://subsum.io" }
      ],
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://subsum.io" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,PATCH,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, Cookie, x-affine-version, x-operation-name, x-affine-csrf-token, x-request-id" }
      ]
    },
    {
      "source": "/api/(.*)",
      "has": [
        { "type": "header", "key": "origin", "value": "https://www.subsum.io" }
      ],
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://www.subsum.io" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,PATCH,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, Cookie, x-affine-version, x-operation-name, x-affine-csrf-token, x-request-id" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.subsum.io/api/:path*"
    },
    {
      "source": "/graphql",
      "destination": "https://api.subsum.io/graphql"
    },
    {
      "source": "/graphql/:path*",
      "destination": "https://api.subsum.io/graphql/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "https://api.subsum.io/socket.io"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://api.subsum.io/socket.io/:path*"
    },
    {
      "source": "/((?!api/|graphql|socket.io|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
